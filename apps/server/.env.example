# 复制本文件为 .env 并填入真实值（.env 不进 git）

# PostgreSQL 连接串，格式：postgresql://用户名:密码@主机:端口/库名
# 运行时连接（PrismaService 经 adapter 使用），本地开发示例：postgresql://postgres:123456@localhost:5432/shiguang
DATABASE_URL="postgresql://user:password@localhost:5432/shiguang"

# Prisma CLI 迁移连接串（prisma.config.ts 的 datasource.url）。本地开发与 DATABASE_URL 相同即可；
# 使用 Supabase 等托管库时必须为会话池（DIRECT_URL），不能走事务池（DATABASE_URL），否则 migrate 挂起。
DIRECT_URL="postgresql://user:password@localhost:5432/shiguang"

# JWT 签名密钥（必填，无默认值；缺失会导致后端启动失败）
JWT_SECRET="your-secret"

# LLM（OpenAI-compatible 端点）：AI 对话与 pnpm recipes:generate 共用
OPENAI_API_KEY="sk-..."
OPENAI_BASE_URL="https://api.openai.com/v1"
MODEL_NAME="gpt-4o-mini"

# 候选重排序（ADR-0020）：off | shadow | live，默认 off——未启用时搜索保持原有排序
JEV_RERANK_MODE="off"
# 启用时必填：模型名。代理路由名与官方版本名不同（如路由 g-jev-1.13 响应 jev-1.13.0），
# 以服务端实际可用路由为准，代码里不硬编码任何一个
JEV_RERANK_MODEL="g-jev-1.13"
# 候选池上限 = 单次搜索最大调用数（默认 12，与工具 limit 上限一致）
JEV_RERANK_MAX_CANDIDATES="12"
# 单次搜索墙钟预算，毫秒（默认 2000）
JEV_RERANK_TIMEOUT_MS="2000"
# 生效比例 0–100（默认 0；仅 live 模式有意义）
JEV_RERANK_ROLLOUT_PERCENT="0"
# 令牌桶补充速率，次/分钟（默认 90；账号上限 100）
JEV_RERANK_RPM="90"
# 累计预算上限 US$（默认 0 = 不限）
JEV_RERANK_BUDGET_USD="0"
# 估算单价 US$/百万 token（默认 0.042，仅用于预算估算，不是账单）
JEV_RERANK_PRICE_PER_MTOK="0.042"

# Jev 凭证：仅在 JEV_RERANK_MODE != off 时需要，只从服务端环境变量读取
TYPESAFE_API_KEY=""
TYPESAFE_BASE_URL="https://lab.iwhalecloud.com/gpt-proxy/jev"
