generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model RecipeIngredient {
  recipeId     String
  ingredientId String
  // 菜谱内的用量与必要说明（如「1块(约150g)」「西冷或眼肉」），归一后原样保留
  name         String
  amount       String
  note         String?
  position     Int
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([recipeId, ingredientId])
  @@index([ingredientId])
}

model Recipe {
  id          String     @id @default(cuid())
  name        String     @unique
  desc        String
  cuisine     Cuisine
  time        Int
  kcal        Int
  protein     Int
  carb        Int
  fat         Int
  img         String     @default("")
  tags        Tag[]
  ingredients Json
  steps       Json
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  favorites   Favorite[]

  ingredientLinks RecipeIngredient[]

  @@index([cuisine])
  @@index([time])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  favorites     Favorite[]
  preference    UserPreference?
  conversations Conversation[]
  refreshTokens RefreshToken[]
}

// refresh token 轮换表（ADR-0013）：只存 bcrypt 哈希，一次一换，30 天滑动过期
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // bcrypt(opaque token)，不存明文
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Conversation {
  id             String    @id @default(cuid())
  userId         String
  title          String
  // 会话摘要（ADR-0010/0012）：滑窗之外消息的压缩摘要，注入 system prompt
  summary        String?
  // 摘要已覆盖到的消息 seq（溢出区 = seq ≤ maxSeq−滑窗 且 seq > summaryUpToSeq）
  summaryUpToSeq Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  seq            Int // 消息在会话中的单调递增序号（消息级，1 起；应用层 max(seq)+1）
  role           String // user | assistant（实际两类；tool 信息在 assistant.parts 内）
  parts          Json // 原始 UIMessage parts 数组（保序，含 text/tool 交错结构，还原唯一来源）
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, seq])
  @@index([conversationId, seq])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
}

model UserPreference {
  id                  String     @id @default(cuid())
  userId              String     @unique
  dislikedIngredients String[]
  allergens           String[]
  healthGoal          HealthGoal @default(BALANCED)
  updatedAt           DateTime   @updatedAt
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 食材稳定身份（ADR-0018）。发布状态由数据库承载，审核资料文件是发布输入。
model Ingredient {
  id          String             @id @default(cuid())
  /// 展示主名；与别名的解析共用归一规则
  name        String             @unique
  /// 一层主要浏览分类，每食材归属一个
  category    IngredientCategory
  /// 经人工审核的简介；未审核不发布
  summary     String?
  /// 简要挑选说明（无可靠依据则缺省）
  selection   String?
  /// 简要保存说明（无可靠依据则缺省；不编造精确保存时长）
  storage     String?
  /// 简要处理说明（无可靠依据则缺省）
  preparation String?
  /// 可核查参考来源；未填写不发布
  sources     String[]
  /// 人工审核通过标记与时间
  reviewedAt  DateTime?
  published   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  aliases     IngredientAlias[]
  allergens   IngredientAllergen[]
  recipeLinks RecipeIngredient[]

  @@index([category])
}

/// 食材别名（ADR-0018）：同物异名归入同一身份，相近/可替代原料不合并
model IngredientAlias {
  id           String     @id @default(cuid())
  ingredientId String
  alias        String     @unique
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
}

/// 食材过敏原关系（ADR-0018）：与别名分离；成分信息不足时不写行，
/// 不写行表示「信息不足」，不等于「确认不含」。
model IngredientAllergen {
  id           String     @id @default(cuid())
  ingredientId String
  allergen     String
  /// 可核查依据（来源链接或说明），发布过敏原关系必需
  source       String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, allergen])
}

enum IngredientCategory {
  VEGETABLE
  MEAT
  POULTRY
  EGG
  SEAFOOD
  SOY
  GRAIN
  SEASONING
  OTHER
}

enum Cuisine {
  HOME
  WESTERN
  JAPANESE
  SICHUAN
  LIGHT
}

enum HealthGoal {
  BALANCED
  FAT_LOSS
  MUSCLE_GAIN
}

enum Tag {
  VEGETARIAN
  HIGH_PROTEIN
  LOW_CAL
  LOW_CARB
  QUICK
  RICE_FRIENDLY
  COMFORTING
}
