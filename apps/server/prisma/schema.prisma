generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Recipe {
  id          String   @id @default(cuid())
  name        String   @unique
  desc        String
  cuisine     Cuisine
  time        Int
  kcal        Int
  protein     Int
  carb        Int
  fat         Int
  img         String   @default("")
  tags        Tag[]
  ingredients Json
  steps       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  favorites Favorite[]

  @@index([cuisine])
  @@index([time])
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  displayName   String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pantryItems   PantryItem[]
  favorites     Favorite[]
  preference    UserPreference?
  conversations Conversation[]
  refreshTokens RefreshToken[]
}

// refresh token 轮换表（ADR-0013）：只存 bcrypt 哈希，一次一换，30 天滑动过期
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // bcrypt(opaque token)，不存明文
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Conversation {
  id             String    @id @default(cuid())
  userId         String
  title          String
  // 会话摘要（ADR-0010/0012）：滑窗之外消息的压缩摘要，注入 system prompt
  summary        String?
  // 摘要已覆盖到的消息 seq（溢出区 = seq ≤ maxSeq−滑窗 且 seq > summaryUpToSeq）
  summaryUpToSeq Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  seq            Int // 消息在会话中的单调递增序号（消息级，1 起；应用层 max(seq)+1）
  role           String // user | assistant（实际两类；tool 信息在 assistant.parts 内）
  parts          Json // 原始 UIMessage parts 数组（保序，含 text/tool 交错结构，还原唯一来源）
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, seq])
  @@index([conversationId, seq])
}

model PantryItem {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
}

model UserPreference {
  id                  String      @id @default(cuid())
  userId              String      @unique
  dislikedIngredients String[]
  allergens           String[]
  healthGoal          HealthGoal  @default(BALANCED)
  updatedAt           DateTime    @updatedAt
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Cuisine {
  HOME
  WESTERN
  JAPANESE
  SICHUAN
  LIGHT
}

enum HealthGoal {
  BALANCED
  FAT_LOSS
  MUSCLE_GAIN
}

enum Tag {
  VEGETARIAN
  HIGH_PROTEIN
  LOW_CAL
  LOW_CARB
  QUICK
  RICE_FRIENDLY
  COMFORTING
}
